# Copy to .env and fill in. Never commit your real .env.

COMMBOT_DB=commbot.db
DEFAULT_LANG=hi

# ---- Sources -------------------------------------------------------------
# Comma-separated CAP XML / RSS URLs or local file paths.
# Get the official feed link from the SACHET portal (sachet.ndma.gov.in).
CAP_FEEDS=samples/flood_alert.xml
# Optional model-forecast rain watch points: "lat,lon,Name;lat,lon,Name"
WEATHER_POINTS=27.57,81.60,Bahraich

# ---- LLM (optional) ------------------------------------------------------
LLM_ENABLED=false
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- SMS -----------------------------------------------------------------
# console | twilio | http_gateway
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# ---- Decision agent -------------------------------------------------------
PUSH_THRESHOLD=6
REQUIRE_APPROVAL=true
APPROVAL_TIMEOUT_MIN=10
RESEND_COOLDOWN_MIN=180
MAX_SMS_PER_HOUR=4
MAX_SMS_SEGMENTS=3
POLL_INTERVAL_SEC=120

# ---- Webhooks / voice -----------------------------------------------------
# Your public HTTPS URL (e.g. the ngrok URL while testing)
PUBLIC_BASE_URL=
VALIDATE_TWILIO_SIGNATURE=true
ASR_MODEL_SIZE=small

# ---- Dashboard (optional) -------------------------------------------------
FIREBASE_CREDENTIALS=
